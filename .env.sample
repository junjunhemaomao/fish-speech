# Fish Speech environment variables
# Copy to .env and customize:  cp .env.sample .env
#
# === Device ===
# cuda (NVIDIA GPU) | cpu | mps (Apple Silicon) | xpu (Intel GPU)
DEVICE=cuda
# Enable half precision — MUST be true for GPUs with ≤8GB VRAM
HALF=true
# torch.compile() — adds startup time but speeds up inference; keep false for first run
COMPILE=false

# === Server ===
API_KEY=
LISTEN=127.0.0.1:8080
WORKERS=1

# === Model paths (relative to project root) ===
LLAMA_CHECKPOINT_PATH=checkpoints/s2-pro
DECODER_CHECKPOINT_PATH=checkpoints/s2-pro/codec.pth
DECODER_CONFIG_NAME=modded_dac_vq
